# ============================================
# Next.js Application Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ============================================
# n8n Integration
# ============================================
# The URL of your n8n "On form submission" webhook
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id

# Secret string shared between this app and n8n for callback authentication
N8N_CALLBACK_SECRET=your-secret-key-here

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (server-side only, keep secret!)
# This has elevated permissions, never expose it in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# TinaCMS Configuration (Tina Cloud)
# ============================================
# Get these from https://app.tina.io after creating a project
# Client ID for Tina Cloud (public, safe to expose)
NEXT_PUBLIC_TINA_CLIENT_ID=your-tina-client-id

# Git branch to use for content (optional, defaults to "main")
# Usually matches your current git branch (main, develop, etc.)
NEXT_PUBLIC_TINA_BRANCH=main

# Tina Cloud read token (server-side only, keep secret!)
# Used for server-side content fetching
TINA_TOKEN=your-tina-read-token

# ============================================
# Optional: Other Services
# ============================================
# Comet API key (if using Comet service)
# COMET_API_KEY=your-comet-api-key
