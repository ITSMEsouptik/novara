# ============================================
# Next.js Application Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ============================================
# n8n Integration
# ============================================
# The URL of your n8n "On form submission" webhook
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id

# Secret string shared between this app and n8n for callback authentication
N8N_CALLBACK_SECRET=your-secret-key-here

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (server-side only, keep secret!)
# This has elevated permissions, never expose it in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Perplexity API Configuration
# ============================================
# Get your API key from https://www.perplexity.ai/settings/api
# Perplexity API key for deep brand/market analysis
PERPLEXITY_API_KEY=your-perplexity-api-key

# Perplexity API endpoint (optional, uses default if not set)
PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions

# Perplexity model to use (optional, uses default if not set)
# Use llama-3.1-sonar-large-128k-online for web search capability
PERPLEXITY_MODEL=sonar-pro

# ============================================
# Optional: Other Services
# ============================================
# Comet API key (if using Comet service)
# COMET_API_KEY=your-comet-api-key
